{
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ES2024", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
		"paths": {
      "@tsn-array/*": ["./src/typescript-helper/natives/array/*"],
      "@tsn-class/*": ["./src/typescript-helper/natives/class/*"],
      "@tsn-console/*": ["./src/typescript-helper/natives/console/*"],
      "@tsn-date/*": ["./src/typescript-helper/natives/date/*"],
      "@tsn-function/*": ["./src/typescript-helper/natives/function/*"],
      "@tsn-json/*": ["./src/typescript-helper/natives/json/*"],
      "@tsn-math/*": ["./src/typescript-helper/natives/math/*"],
      "@tsn-number/*": ["./src/typescript-helper/natives/number/*"],
      "@tsn-object/*": ["./src/typescript-helper/natives/object/*"],
      "@tsn-regex/*": ["./src/typescript-helper/natives/regex/*"],
      "@tsn-string/*": ["./src/typescript-helper/natives/string/*"],
      "@tsn/*": ["./src/typescript-helper/natives/*"],
      "@tsi/*": ["./src/typescript-helper/interfaces/*"],
      "@tsu/*": ["./src/typescript-helper/unknown/*"],
      "@tsrn/*": ["src/react-native-helper/*"],
      "@tsr/*": ["src/react-helper/*"],
      "@ts/*": ["./src/typescript-helper/*"]
		}
  },
  "tsc-alias": {
    
  }
}
