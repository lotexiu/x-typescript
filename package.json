{
  "name": "x-typescript",
  "version": "0.2.1-alpha.0",
  "description": "א TypeScript - All your TypeScript needs in one package",
  "keywords": [
    "typescript",
    "library"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:webpack",
    "prepare": "npm run build",
    "watch": "webpack --watch",
    "clean": "rm -rf dist",
    "build:webpack": "webpack --mode=production",
    "p": "npm publish",
    "p-alpha": "npm publish --tag alpha"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-native": "^0.82.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/react": "^19.2.2",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.4",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.6",
    "semantic-release": "25.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "tsc-alias": "^1.2.1",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
