{
  "author": "lotexiu",
  "name": "x-typescript",
  "version": "0.2.1-alpha.0",
  "description": "א TypeScript - All your TypeScript needs in one package",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lotexiu/x-typescript"
  },
  "bugs": {
    "url": "https://github.com/lotexiu/x-typescript/issues"
  },
  "homepage": "https://github.com/lotexiu/x-typescript#readme",
  "keywords": [
    "library",
    "typescript",
    "react",
    "react-native",
    "nextjs",
    "angular",
    "sass"
  ],
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "exposeFiles": {
    "./scss/*": {
      "sass": [
        "./dist/scss/*.scss"
      ]
    }
  },
  "scripts": {
    "build": "npm run clean && vite build",
    "prepare": "npm run build",
    "watch": "chokidar 'src/**/*.{ts,scss}' -c 'vite build'",
    "clean": "rm -rf dist",
    "p": "npm publish",
    "p-alpha": "npm publish --tag alpha"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-native": "^0.82.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/react": "^19.2.2",
    "chokidar-cli": "^3.0.0",
    "semantic-release": "25.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "sideEffects": false,
  "type": "module",
  "dependencies": {
    "glob": "^11.0.3"
  }
}
